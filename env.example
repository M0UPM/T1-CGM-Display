# Copy to .env in the same directory as docker-compose.yml, then fill in.
#   cp env.example .env && chmod 600 .env

# ---- Platform ------------------------------------------------------------

# Which MongoDB to run. Run ./preflight.sh and use what it tells you.
#   7    normal case - needs AVX (x86_64) or ARMv8.2-A (arm64)
#   4.4  no AVX: Celeron, Atom, Pentium Silver, N-series, pre-2011 Intel,
#        AMD Phenom II. Also Pi 4 and older.
# Getting this wrong looks like: mongod exits immediately,
# "Illegal instruction (core dumped)" in the logs.
MONGO_TAG=7

# ---- Nightscout ----------------------------------------------------------

# Root password for Nightscout. Minimum 12 characters. Changing this later
# invalidates every access token you've created, so pick it once.
API_SECRET=change_me_at_least_twelve_chars

# The Pi's LAN address, as the browser will reach it. Must include the port.
# Nightscout builds redirects from this and gets sulky if it's wrong.
BASE_URL=http://192.168.1.50:1337

# Which interface to bind to. 0.0.0.0 = reachable from anywhere on your LAN
# (so your phone and your wife's can view it on the wifi).
# Set to 127.0.0.1 if you want it ONLY on the display screen.
NS_BIND=0.0.0.0

# Access token for the bridge to write with. Create this AFTER first boot.
#
# TWO THINGS THAT WILL COST YOU AN HOUR IF MISSED:
#
# 1. The bridge needs api:entries:create, and NO built-in Nightscout role
#    grants it. Create a role first:
#      Admin Tools -> Roles section -> Add new Role
#      Name: entries-upload   Permissions: api:entries:create
#    Then the subject:
#      Admin Tools -> Add new Subject
#      Name: librelink
#      Roles: careportal devicestatus-upload entries-upload
#    Without entries-upload you get HTTP 401 on every glucose upload.
#
# 2. This variable wants the SHA1 HASH of the token, not the token.
#    The name is misleading - the bridge sends it as a pre-hashed API
#    secret. A raw token gives 401 with no useful error.
#
#      echo -n "librelink-YOURTOKENHERE" | sha1sum | cut -d' ' -f1
#
#    Mind the -n. A trailing newline changes the hash.
NS_API_TOKEN=

# ---- LibreLinkUp ---------------------------------------------------------

# Use the SECOND LibreView account - the one that follows her, not the one
# that owns the sensor. Never put the primary account credentials here.
LINK_UP_USERNAME=
LINK_UP_PASSWORD=

# Only needed if that account follows more than one person. Leave blank and
# read the container logs - it prints the available patient IDs on startup.
LINK_UP_CONNECTION=

# LibreLinkUp region. UK accounts may be on EU or EU2 - the bridge tells you
# which if you pick wrong ("Logged in to the wrong region. Switch to 'EU2'").
# Valid: AE AP AU CA DE EU EU2 FR JP US LA RU CN
LINK_UP_REGION=EU

# The LibreLinkUp app version string. When the bridge starts failing auth
# out of nowhere, this is almost always why - Abbott bumped the app and
# started rejecting old ones. Check the upstream repo README for current.
LINK_UP_VERSION=4.16.0

# ---- Glooko (optional - treatments only) ---------------------------------

# The only automatic route for bolus/carb data:
#   pen or pump -> mylife App -> mylife Cloud -> Glooko -> here
#
# Runs as a Nightscout plugin. Set this to 'connect' to turn it on:
NS_EXTRA_ENABLE=

CONNECT_GLOOKO_EMAIL=
CONNECT_GLOOKO_PASSWORD=

# 'eu' for UK. Maps to eu.api.glooko.com.
CONNECT_GLOOKO_ENV=eu

# Hours from UTC. 1 during BST, 0 in winter. Does NOT auto-adjust - change it
# in March and October or treatments land an hour out.
CONNECT_GLOOKO_TIMEZONE_OFFSET=1

# ---- Alerting (optional) -------------------------------------------------

# Telegram, for the staleness watchdog. This alerts on the PLUMBING - the feed
# stopping - never on glucose values. Glucose alarms stay with the Libre app.
#
# Setup:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#      It gives you a token like 8123456789:AAH...
#   2. Send your new bot a message (it can't message you first).
#   3. Get the chat id:
#        curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#          | grep -o '"id":[-0-9]*' | head -1
#      A group chat id is negative - that's normal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minutes of silence before it counts as stale. Libre 2 Plus streams every
# minute; raise this if the phone routinely wanders out of range at night and
# you start getting noise.
STALE_MINUTES=20

# Any other endpoint you already use - ntfy topic, webhook, etc.
NOTIFY_URL=

# ---- Backups -------------------------------------------------------------

# Where to push the nightly encrypted dump. Your VPS.
BACKUP_TARGET=user@backuphost:/srv/backups/nightscout/

# age public key (age1...). Generate the keypair OFF this Pi:
#   age-keygen -o ns-backup.key
# Keep the private key somewhere that isn't the Pi and isn't the VPS -
# a backup you can't decrypt after a house fire isn't a backup.
AGE_RECIPIENT=

# How many nightly dumps to keep locally before pruning.
BACKUP_KEEP=7
